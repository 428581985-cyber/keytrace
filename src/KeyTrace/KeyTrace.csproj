<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe：不分配控制台。双击或开机自启时不会闪黑框。 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 为了 System.Windows.Automation（UIA），读上屏文字要用；和 WinForms 同属 WindowsDesktop，不额外增重 -->
    <UseWPF>true</UseWPF>
    <RootNamespace>KeyTrace</RootNamespace>
    <AssemblyName>keytrace</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <ApplicationIcon>..\..\assets\keytrace.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KeyTrace.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 中文练习材料要用的字表（7258 字：音节 + 词频 + 小鹤双拼码）。
         编进程序集而不是放旁边当文件：publish 成单文件时不用管路径。 -->
    <EmbeddedResource Include="..\..\data\zh-hanzi.tsv" LogicalName="KeyTrace.data.zh-hanzi.tsv" />
    <!-- 托盘与桌面窗口使用的多分辨率图标（录制中 / 已暂停）。 -->
    <EmbeddedResource Include="..\..\assets\keytrace.ico" LogicalName="KeyTrace.assets.keytrace.ico" />
    <EmbeddedResource Include="..\..\assets\keytrace-paused.ico" LogicalName="KeyTrace.assets.keytrace-paused.ico" />
  </ItemGroup>

</Project>
